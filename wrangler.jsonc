{
  "$schema": "https://unpkg.com/wrangler@4.154.0/config-schema.json",
  "name": "open-obsidian",
  "compatibility_date": "2026-10-28",
  // Custom Domains imply workers_dev=false; preview_urls follows workers_dev
  // by default, so it must stay explicit or PR previews stop working.
  "preview_urls": true,
  "routes": [{ "pattern": "open-obsidian.stefanhoth.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
  },
}
